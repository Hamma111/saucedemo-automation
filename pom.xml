<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.saucedemo</groupId>
    <artifactId>saucedemo-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>SauceDemo UI Automation</name>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Deliberately conservative versions (Java 11 compatible, widely cached). -->
        <selenium.version>4.12.1</selenium.version>
        <testng.version>7.7.0</testng.version>

        <!-- TestNG groups to run, e.g. -Dgroups=smoke. Empty runs everything. -->
        <groups/>
        <!-- Test classes run in parallel; -Dthreads=1 runs them one at a time. -->
        <threads>5</threads>
    </properties>

    <dependencies>
        <!-- Selenium 4 ships Selenium Manager, which downloads the matching ChromeDriver. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- Stay on 3.5.x: 3.6.0 dropped testng.xml suite support. -->
                <version>3.5.6</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <groups>${groups}</groups>
                    <!-- A mistyped group name should fail the build, not pass with 0 tests. -->
                    <failIfNoTests>true</failIfNoTests>
                    <properties>
                        <property>
                            <name>threadcount</name>
                            <value>${threads}</value>
                        </property>
                    </properties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
